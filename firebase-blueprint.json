{
  "entities": {
    "places": {
      "title": "Places",
      "description": "Monitored geospatial places dataset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "place_name": { "type": "string" },
        "area": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["id", "place_name", "latitude", "longitude"]
    },
    "snapshots": {
      "title": "Snapshots",
      "description": "Historical map snapshots for places",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placeId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "number" },
        "dateLabel": { "type": "string" },
        "notes": { "type": "string" },
        "zoomLevel": { "type": "number" },
        "mapType": { "type": "string" }
      },
      "required": ["id", "placeId", "imageUrl", "timestamp", "dateLabel"]
    },
    "accidents": {
      "title": "Accidents",
      "description": "City accident events (car accident, nature event, tree cutting, building construction, damage, weather, animal dies)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placeId": { "type": "string" },
        "placeName": { "type": "string" },
        "cityName": { "type": "string" },
        "accidentType": { "type": "string" },
        "severity": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "placeId", "accidentType", "severity", "timestamp"]
    },
    "alarms": {
      "title": "Alarms",
      "description": "Accident and incident alarms configured for cities and places",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accidentType": { "type": "string" },
        "severityThreshold": { "type": "string" },
        "isMuted": { "type": "boolean" },
        "audioAlertEnabled": { "type": "boolean" },
        "createdDate": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["id", "accidentType", "severityThreshold"]
    },
    "users": {
      "title": "Users",
      "description": "Registered and authorized users with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "analyst", "viewer"] },
        "isAuthorizedAdmin": { "type": "boolean" },
        "department": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "audit_logs": {
      "title": "Audit Logs",
      "description": "Administrative actions and security audit log entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorUid": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "number" },
        "ipAddress": { "type": "string" }
      },
      "required": ["id", "action", "actorEmail", "timestamp"]
    }
  },
  "firestore": {
    "/places/{placeId}": {
      "schema": "places",
      "description": "Geospatial place datasets"
    },
    "/snapshots/{snapshotId}": {
      "schema": "snapshots",
      "description": "Captured map snapshots"
    },
    "/accidents/{accidentId}": {
      "schema": "accidents",
      "description": "Geospatial accident event records"
    },
    "/alarms/{alarmId}": {
      "schema": "alarms",
      "description": "Configured incident alarms"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and authorized admin roles"
    },
    "/audit_logs/{logId}": {
      "schema": "audit_logs",
      "description": "Administrative security audit trail entries"
    },
    "/test/{testId}": {
      "schema": "places",
      "description": "Connection health test path"
    }
  }
}
